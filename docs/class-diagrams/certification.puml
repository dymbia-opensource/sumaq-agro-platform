' Diagram Legend

legend right
  |= Stereotype |= Classification |= Layer |
  |<back:#E3F2FD> <<aggregate>> </back> | Aggregate Root (Encapsulated) | Domain Layer |
  |<back:#E8F5E9> <<entity>> </back> | Domain Entity | Domain Layer |
  |<back:#FFF3E0> <<value object>> </back> | Tactical Value Object | Domain Layer |
  |<back:#FFF8E1> <<record>> </back> | Immutable Java Record | Domain / Interfaces |
  |<back:#F3E5F5> <<service>> </back> | Command / Query Service (CQRS) | Application Layer |
  |<back:#FCE4EC> <<repository>> </back> | Domain Repository Port | Domain Layer |
  |<back:#ECEFF1> <<adapter>> </back> | Infrastructure Adapter (JPA/Security/Brevo) | Infrastructure Layer |
  |<back:#FFFDE7> <<controller>> </back> | REST Controller (Endpoints) | Interfaces Layer |
  |<back:#E0F7FA> <<facade>> </back> | Anti-Corruption Layer (ACL) | Interfaces / Application |
  |<back:#F1F8E9> <<event handler>> </back> | Application Event Handler | Application Layer |
endlegend

' Harvest Certification Bounded Context

package "com.dymbia.sumaqagro.platform.certification" {

  package "interfaces.rest" {
    class CertificationAccess <<component>> {
      -queries: HarvestCertificationQueryService
      -profiles: ExternalProfilesService
      -fields: ExternalFarmingService
    }

    class CertificationWorkspaceController <<controller>> {
      -queries: HarvestCertificationQueryService
      -access: CertificationAccess
      -publicBaseUrl: String
      +list(cooperativeId: Long, principal: UserDetailsImpl): ResponseEntity<List<BatchEntry>>
      +download(qualityCertificateId: Long, principal: UserDetailsImpl): ResponseEntity<byte[]>
      +BatchEntry(batch: HarvestBatchResource, certificate: QualityCertificateResource): record
    }

    class HarvestBatchesController <<controller>> {
      -access: CertificationAccess
      -harvestBatchCommandService: HarvestBatchCommandService
      -harvestCertificationQueryService: HarvestCertificationQueryService
      +registerHarvestBatch(resource: RegisterHarvestBatchResource, principal: UserDetailsImpl): ResponseEntity<?>
      +getHarvestBatchById(harvestBatchId: Long, principal: UserDetailsImpl): ResponseEntity<?>
      +weighHarvestBatch(harvestBatchId: Long, resource: WeighHarvestBatchResource, principal: UserDetailsImpl): ResponseEntity<?>
      +extractRepresentativeSample(harvestBatchId: Long, resource: ExtractRepresentativeSampleResource, principal: UserDetailsImpl): ResponseEntity<?>
      +gradePotatoCalibers(harvestBatchId: Long, resource: GradePotatoCalibersResource, principal: UserDetailsImpl): ResponseEntity<?>
      +cupCoffee(harvestBatchId: Long, resource: CupCoffeeResource, principal: UserDetailsImpl): ResponseEntity<?>
    }

    class PublicTraceabilityController <<controller>> {
      -harvestCertificationQueryService: HarvestCertificationQueryService
      +verify(number: String, hash: String): ResponseEntity<?>
    }

    class QualityCertificatesController <<controller>> {
      -access: CertificationAccess
      -qualityCertificateCommandService: QualityCertificateCommandService
      -harvestCertificationQueryService: HarvestCertificationQueryService
      -publicBaseUrl: String
      +issueQualityCertificate(resource: IssueQualityCertificateResource, principal: UserDetailsImpl): ResponseEntity<?>
      +getQualityCertificateByNumber(certificateNumber: String, principal: UserDetailsImpl): ResponseEntity<?>
      +revokeQualityCertificate(qualityCertificateId: Long, principal: UserDetailsImpl): ResponseEntity<?>
    }
  }

