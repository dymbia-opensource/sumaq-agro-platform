      -certificateHash: String
      -issuedByUserId: Long
      -issuedAt: Instant
      -status: CertificateStatus
      +QualityCertificate(certificateNumber: String, harvestBatchId: Long, qualityCategory: QualityCategory, certificateHash: String, issuedByUserId: Long, issuedAt: Instant)
