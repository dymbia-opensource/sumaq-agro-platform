@startuml
title Subscriptions and Payments — Domain Model
skinparam classAttributeIconSize 0

class Subscription <<Aggregate Root>> {
  - id: Long
  - userId: long
  - planCode: PlanCode
  - billingCycle: BillingCycle
  - status: SubscriptionStatus
  + renew(cycle: BillingCycle, approvedOn: LocalDate): void
  + cancelRenewal(): void
  + hasAccessOn(date: LocalDate): boolean
}

class Plan <<Catalog Entity>> {
  - code: PlanCode
  - monthlyPrice: BigDecimal
  - annualPrice: BigDecimal
  - registeredPlotLimit: int
  - producerLimit: int
  - supervisedPlotLimit: int
  + priceFor(cycle: BillingCycle): BigDecimal
}

class Payment <<Record>> {
  + reference: String
  + userId: long
  + subscriptionId: Long
  + planCode: PlanCode
  + billingCycle: BillingCycle
  + amount: BigDecimal
  + status: PaymentStatus
  + attemptedAt: Instant
}

class SubscriptionPeriod <<Value Object>> {
  + startDate: LocalDate
  + endDate: LocalDate
  + includes(date: LocalDate): boolean
}

enum PlanCode {
  SEED
  COOPERATIVE_PRO
  TECHNICAL_ADVISOR
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  COMPLETED
  REJECTED
}

Subscription *-- "1" SubscriptionPeriod
Subscription ..> Plan : planCode
Subscription --> BillingCycle
Subscription --> SubscriptionStatus
Plan --> PlanCode
Payment --> PaymentStatus
Payment ..> "0..1" Subscription : subscriptionId

note right of Payment
  A rejected first checkout can be recorded
  before a subscription exists.
end note
@enduml