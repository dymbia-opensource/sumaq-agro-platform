endlegend

' Shared Kernel

package "com.dymbia.sumaqagro.platform.shared" {

  package "interfaces.rest" {
    class GlobalExceptionHandler <<exception handler>> {
      #handleMethodArgumentNotValid(ex: MethodArgumentNotValidException, headers: HttpHeaders, status: HttpStatusCode, request: WebRequest): ResponseEntity<Object>
      +handleIllegalArgumentException(ex: IllegalArgumentException): ResponseEntity<ProblemDetail>
      +handleAccessDeniedException(ex: AccessDeniedException): ResponseEntity<ProblemDetail>
      +handleAuthenticationException(ex: AuthenticationException): ResponseEntity<ProblemDetail>
      +handleRuntimeException(ex: RuntimeException): ResponseEntity<ProblemDetail>
      +handleException(ex: Exception): ResponseEntity<ProblemDetail>
    }
  }

  package "interfaces.rest.resources" {
    class MessageResource <<record>> {
      +message: String
    }
  }

  package "interfaces.rest.transform" {
    class ProblemDetailFromApplicationErrorAssembler <<assembler>> {
      +{static} toProblemDetailFromApplicationError(error: ApplicationError): ProblemDetail
      +{static} toResponseFromApplicationError(error: ApplicationError): ResponseEntity<ProblemDetail>
      +{static} toStatusFromErrorCode(errorCode: String): HttpStatusCode
    }

    class ResponseEntityAssembler <<assembler>> {
      +{static} toResponseEntityFromResult(result: Result<T, ApplicationError>, successResourceAssembler: Function<T, R>, successStatus: HttpStatusCode): ResponseEntity<?>
    }
  }

  package "application.outboundservices.email" {
    interface EmailSender <<port>> {
      +send(recipientEmail: String, subject: String, htmlContent: String): void
      +isEnabled(): boolean
    }
  }

  package "application.result" {
    class ApplicationError <<record>> {
      +code: String
      +message: String
      +details: String
      +{static} validationError(fieldOrConcept: String, reason: String): ApplicationError
      +{static} notFound(resourceType: String, identifier: String): ApplicationError
      +{static} businessRuleViolation(rule: String, reason: String): ApplicationError
      +{static} conflict(resource: String, reason: String): ApplicationError
      +{static} unexpected(context: String, reason: String): ApplicationError
    }

    interface Result<T, E> <<sealed utility>> {
      +{static} success(value: T): Result<T, E>
      +{static} failure(error: E): Result<T, E>
      +isSuccess(): boolean
      +isFailure(): boolean
      +toOptional(): Optional<T>
      +getOrElse(defaultValue: T): T
      +mapError(f: Function<E, E2>): Result<T, E2>
      +flatMap(f: Function<T, Result<T2, E>>): Result<T2, E>
      +map(f: Function<T, T2>): Result<T2, E>
      +recover(f: Function<E, Result<T, E>>): Result<T, E>
    }
  }

  package "domain.model.aggregates" {
    abstract class AbstractDomainAggregateRoot<T> <<base aggregate>> {
      #registerDomainEvent(event: Object): void
      +domainEvents(): Collection<Object>
      +clearDomainEvents(): void
    }
  }

  package "infrastructure.concurrency.loom.configuration" {
    class VirtualThreadsConfiguration <<configuration>> {
      +applicationTaskExecutor(): TaskExecutor
    }
  }

  package "infrastructure.documentation.openapi.configuration" {
    class OpenApiConfiguration <<configuration>>
  }

  package "infrastructure.email" {
    class DisabledEmailSender <<adapter>> {
      +send(recipientEmail: String, subject: String, htmlContent: String): void
      +isEnabled(): boolean
    }
  }

  package "infrastructure.email.brevo" {
    class BrevoEmailSender <<adapter>> {
      -client: RestClient
      -senderEmail: String
      -senderName: String
    }
  }

  package "infrastructure.events" {
    class DomainEventPublisher <<adapter>> {
      -applicationEventPublisher: ApplicationEventPublisher
      +publishAndClearEvents(aggregate: T): void
    }
  }

  package "infrastructure.i18n.configuration" {
    class LocaleConfiguration <<configuration>> {
      +localeResolver(): LocaleResolver
    }
  }

  package "infrastructure.persistence.jpa.configuration.strategy" {
    class JpaAuditingConfiguration <<configuration>>

    class SnakeCaseWithPluralizedTablePhysicalNamingStrategy <<configuration>> {
      +toPhysicalCatalogName(identifier: Identifier, jdbcEnvironment: JdbcEnvironment): Identifier
      +toPhysicalSchemaName(identifier: Identifier, jdbcEnvironment: JdbcEnvironment): Identifier
      +toPhysicalTableName(identifier: Identifier, jdbcEnvironment: JdbcEnvironment): Identifier
      +toPhysicalSequenceName(identifier: Identifier, jdbcEnvironment: JdbcEnvironment): Identifier
      +toPhysicalColumnName(identifier: Identifier, jdbcEnvironment: JdbcEnvironment): Identifier
    }
  }

  package "infrastructure.persistence.jpa.entities" {
    abstract class AuditableAbstractPersistenceEntity <<base entity>> {
      -id: Long
      -createdAt: Instant
      -updatedAt: Instant
    }
  }
}

' Relationships

' --- Shared Kernel Relationships ---
DisabledEmailSender ..|> EmailSender
BrevoEmailSender ..|> EmailSender
ProblemDetailFromApplicationErrorAssembler ..> ApplicationError
ResponseEntityAssembler ..> ApplicationError
ResponseEntityAssembler ..> Result

@enduml
