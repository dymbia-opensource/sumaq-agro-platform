      +{static} toCommandFromResource(resource: RegisterHarvestBatchResource): RegisterHarvestBatchCommand
    }

    class WeighHarvestBatchCommandFromResourceAssembler <<assembler>> {
      +{static} toCommandFromResource(harvestBatchId: Long, resource: WeighHarvestBatchResource): WeighHarvestBatchCommand
    }
