package "com.dymbia.sumaqagro.platform.crop" {

  package "interfaces.rest" {
    class AgroclimaticAlertsController <<controller>> {
      -queryService: AgroclimaticAlertQueryService
      +getAgroclimaticAlertsByRegion(region: String): ResponseEntity<List<AgroclimaticAlertResource>>
    }

    class ClimateForecastsController <<controller>> {
      -queryService: ClimateForecastQueryService
      -commandService: ClimateForecastCommandService
      +getClimateForecastsByRegion(region: String): ResponseEntity<List<ClimateForecastResource>>
      +importClimateForecast(resource: ImportClimateForecastResource, authenticatedUserId: Long): ResponseEntity<?>
