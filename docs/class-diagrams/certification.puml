      +cooperativeId: Long
      +memberId: Long
      +plotId: Long
      +cropType: String
      +harvestedOn: LocalDate
      +registeredAt: Instant
      +status: String
      +netWeightKg: BigDecimal
      +sampleIdentifier: String
      +sampleWeightKg: BigDecimal
      +firstCaliberPercentage: BigDecimal
      +secondCaliberPercentage: BigDecimal
      +thirdCaliberPercentage: BigDecimal
      +pestDamagePercentage: BigDecimal
      +coffeeCuppingScore: BigDecimal
      +coffeeFermentDefect: boolean
