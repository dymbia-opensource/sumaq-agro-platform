      -qualityCategory: QualityCategory
      +HarvestBatch(batchCode: String, cooperativeId: Long, memberId: Long, plotId: Long, cropType: CropType, harvestedOn: LocalDate)
      +{static} reconstitute(id: Long, batchCode: String, cooperativeId: Long, memberId: Long, plotId: Long, cropType: CropType, harvestedOn: LocalDate, registeredAt: Instant, status: BatchStatus, netWeightKg: BigDecimal, sampleIdentifier: String, sampleWeightKg: BigDecimal, firstCaliberPercentage: BigDecimal, secondCaliberPercentage: BigDecimal, thirdCaliberPercentage: BigDecimal, pestDamagePercentage: BigDecimal, coffeeCuppingScore: BigDecimal, coffeeFermentDefect: boolean, qualityScore: BigDecimal, qualityCategory: QualityCategory): HarvestBatch
      +weigh(netWeightKg: BigDecimal): void
      +weigh(grossWeightKg: BigDecimal, tareKg: BigDecimal): void
      +extractSample(identifier: String, weightKg: BigDecimal): void
      +gradePotato(distribution: PotatoCaliberDistribution): void
      +cupCoffee(scores: CoffeeCuppingScores, fermentDefect: boolean): void
      +assignQualityScore(score: BigDecimal, category: QualityCategory): void
      +markCertified(): void
      +isReadyForCertification(): boolean
    }

    class QualityCertificate <<aggregate>> {
      -id: Long
