      +recordInputExpense(inputName: String, quantity: BigDecimal, unitPrice: BigDecimal, expenseDate: LocalDate, clientSyncId: String): ExpenseEntry
      +recordDailyLaborExpense(activity: String, workers: int, days: int, dailyWage: BigDecimal, expenseDate: LocalDate, clientSyncId: String): ExpenseEntry
      +recordFieldFreightExpense(route: String, cost: BigDecimal, expenseDate: LocalDate, clientSyncId: String): ExpenseEntry
