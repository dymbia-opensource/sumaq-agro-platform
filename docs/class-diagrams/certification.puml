    }

    class ExtractRepresentativeSampleCommandFromResourceAssembler <<assembler>> {
      +{static} toCommandFromResource(harvestBatchId: Long, resource: ExtractRepresentativeSampleResource): ExtractRepresentativeSampleCommand
